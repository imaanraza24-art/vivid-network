# ---------------------------------------------------------------------------
# Vivid Network — environment variables
#
# Copy this file to `.env.local` for local development, and add the same
# variables in your Vercel project settings (Project → Settings →
# Environment Variables) for production. Never commit real values — only
# this example file with placeholders belongs in git.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical links, sitemap.xml, robots.txt, and
# Open Graph metadata. Safe to expose (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SITE_URL=https://vividnetwork.com

# Destination address for the Contact form and Share Your Story review
# notifications. Defaults to vividnetworkcontact@gmail.com in code if unset.
CONTACT_EMAIL=vividnetworkcontact@gmail.com

# API key for whichever transactional email provider sends Contact form
# and Story Submission notifications (e.g. Resend, Postmark, SendGrid).
# Required for app/api/contact and app/api/story-submission to actually
# deliver mail — without it, submissions are validated and logged but not
# sent. See the "Integration point" comments in those two route files.
EMAIL_PROVIDER_API_KEY=

# Newsletter provider credentials for Vivid Mailbox (e.g. Mailchimp,
# ConvertKit, Buttondown). Required for app/api/newsletter to actually add
# subscribers — without them, signups are validated and logged but not
# forwarded. See the "Integration point" comment in that route file.
NEWSLETTER_PROVIDER_API_KEY=
NEWSLETTER_AUDIENCE_ID=

# Real podcast RSS feed URL for Vivid Voices. Leave empty until Vivid
# Voices has a real feed to point to — do not invent one. Once set, wire it
# up in content/episodes/index.ts's getAllEpisodesFromSource() per the
# instructions in that file.
PODCAST_RSS_URL=

# Optional: blob/object storage credentials for Story Submission file
# uploads (e.g. Vercel Blob, S3-compatible storage), once you decide where
# submitted files should land.
# BLOB_READ_WRITE_TOKEN=
